{
  "name": "dsh-team-model-policy",
  "version": "0.6.0",
  "description": "Configure teammate models and manually retire ordinary subagents or Team members while retaining conversation history.",
  "type": "module",
  "main": "./ui.mjs",
  "exports": {
    ".": "./ui.mjs",
    "./package.json": "./package.json",
    "./client": "./lib/client.js",
    "./policy": "./index.mjs",
    "./retirements": "./retirements.mjs",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.mjs",
    "settings.mjs",
    "choices.mjs",
    "model-tools.mjs",
    "lib/client.js",
    "src/client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "authorization.mjs",
    "ui.mjs",
    "retirements.mjs",
    "THIRD_PARTY_NOTICES.md",
    "locale/*.json"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.1-rc.5"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node tests/run-integration.mjs",
    "check": "node --check index.mjs",
    "build:client": "node src/client/build.cjs",
    "check:client": "node src/client/build.cjs --check"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kogekiplay/dsh-team-model-policy.git"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
