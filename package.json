{
  "name": "dsh-team-model-policy",
  "version": "0.11.0",
  "description": "Remove completed Agent Teams tasks directly from the native task board, with revision and dependency checks and retained history.",
  "type": "module",
  "main": "./ui.mjs",
  "exports": {
    ".": "./ui.mjs",
    "./package.json": "./package.json",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "ui.mjs",
    "task-actions.mjs",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "icon.svg",
    "locale/*.json"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.2"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node tests/run-task-removal.mjs",
    "check": "node --check ui.mjs && node --check task-actions.mjs && node src/client/build.cjs --check",
    "build:client": "node src/client/build.cjs",
    "check:client": "node src/client/build.cjs --check"
  },
  "dsh": {
    "bundle": { "patch": "cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-api-remotes", "@deepseek-ai/dsh-client-ui-agent-team"]
    }
  },
  "repository": { "type": "git", "url": "https://github.com/kogekiplay/dsh-team-model-policy.git" },
  "homepage": "https://github.com/kogekiplay/dsh-team-model-policy#readme",
  "bugs": { "url": "https://github.com/kogekiplay/dsh-team-model-policy/issues" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/", "tag": "latest" },
  "license": "MIT",
  "devDependencies": { "react": "18.3.1" }
}
